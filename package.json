{
  "name": "pagesentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit -p client/tsconfig.json && tsc -p server/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/server/src/index.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui:serve": "tsx tests/ui-server.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "lucide-vue-next": "0.577.0",
    "naive-ui": "2.45.3",
    "playwright": "1.64.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
