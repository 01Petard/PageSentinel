HOST=127.0.0.1
# 使用带鉴权的反向代理时填写访问域名，不含协议和端口。
# PUBLIC_HOST=sentinel.example.com
PORT=3000
DATA_DIR=./data
CHECK_CONCURRENCY=2
NAVIGATION_TIMEOUT_MS=20000
TARGET_TIMEOUT_MS=10000
STABILITY_TIMEOUT_MS=10000
SAMPLE_INTERVAL_MS=1000
# ntfy 完整主题 URL；未配置时保留待发事件，配置并重启后继续发送。
# NTFY_URL=https://ntfy.sh/replace-with-an-unguessable-topic
# NTFY_TOKEN=
# 登录身份功能：两项必须同时配置，启用后不能移除以恢复公开访问。
# 分别运行 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))" 生成独立值。
# ADMIN_TOKEN=
# AUTH_MASTER_KEY=
